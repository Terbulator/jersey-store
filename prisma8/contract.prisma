// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model User {
    id                  String               @id(map: "User_pkey")
    email               String
    emailVerified       TimestampString(3)?
    name                String?
    image               String?
    password            String?
    role                pg.enum(Role)        @default("CUSTOMER")
    createdAt           TimestampString(3)         @default(now())
    updatedAt           TimestampString(3)
    accounts            Account[]
    addresses           Address[]
    cartItems           CartItem[]
    notifications       Notification[]
    orders              Order[]
    permissionOverrides PermissionOverride[]
    reseller            Reseller?
    reviews             Review[]
    sessions            Session[]
    tickets             Ticket[]
    ticketReplies       TicketReply[]
    vendor              Vendor?
    wishlistItems       WishlistItem[]
    workers             Worker[]             @relation(name: "Worker_ownerId_fkey")
    worker              Worker?              @relation(name: "Worker_userId_fkey")

    @@index([email], map: "User_email_key", unique: true)

    @@map("User")
  }

  model Account {
    id                String  @id(map: "Account_pkey")
    userId            String
    _type             String  @map("type")
    provider          String
    providerAccountId String
    refreshToken      String? @map("refresh_token")
    accessToken       String? @map("access_token")
    expiresAt         Int?    @map("expires_at")
    tokenType         String? @map("token_type")
    scope             String?
    idToken           String? @map("id_token")
    sessionState      String? @map("session_state")
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Account_userId_fkey", index: false)

    @@index([provider, providerAccountId], map: "Account_provider_providerAccountId_key", unique: true)

    @@map("Account")
  }

  model Address {
    id         String  @id(map: "Address_pkey")
    userId     String
    fullName   String
    phone      String
    line1      String
    line2      String?
    city       String
    state      String
    postalCode String
    country    String  @default("IN")
    isDefault  Boolean @default(false)
    orders     Order[]
    user       User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Address_userId_fkey", index: false)

    @@map("Address")
  }

  model AuditLog {
    id         String        @id(map: "AuditLog_pkey")
    actorId    String
    actorEmail String
    actorRole  pg.enum(Role)
    action     String
    resource   String
    resourceId String?
    oldValues  Jsonb?
    newValues  Jsonb?
    ip         String?
    result     String        @default("success")
    createdAt  TimestampString(3)  @default(now())

    @@index([actorId], map: "AuditLog_actorId_idx")
    @@index([createdAt], map: "AuditLog_createdAt_idx")
    @@index([resource, resourceId], map: "AuditLog_resource_resourceId_idx")

    @@map("AuditLog")
  }

  model Category {
    id          String       @id(map: "Category_pkey")
    name        String
    slug        String
    description String?
    image       String?
    parentId    String?
    createdAt   TimestampString(3) @default(now())
    products    Product[]
    parent      Category?    @relation(name: "Category_parentId_fkey", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Category_parentId_fkey", index: false)
    categories  Category[]   @relation(name: "Category_parentId_fkey")

    @@index([slug], map: "Category_slug_key", unique: true)

    @@map("Category")
  }

  model Vendor {
    id              String                @id(map: "Vendor_pkey")
    userId          String                @unique(map: "Vendor_userId_key")
    storeName       String
    slug            String
    description     String?
    logo            String?
    banner          String?
    stripeAccountId String?
    commissionRate  Float                 @default(0.15)
    status          pg.enum(VendorStatus) @default("PENDING")
    createdAt       TimestampString(3)          @default(now())
    updatedAt       TimestampString(3)
    payouts         Payout[]
    products        Product[]
    user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Vendor_userId_fkey")

    @@index([slug], map: "Vendor_slug_key", unique: true)
    @@index([stripeAccountId], map: "Vendor_stripeAccountId_key", unique: true)

    @@map("Vendor")
  }

  model Product {
    id              String           @id(map: "Product_pkey")
    vendorId        String
    categoryId      String
    name            String
    slug            String
    description     String
    basePrice       Numeric(10, 2)
    comparePrice    Numeric(10, 2)?
    team            String?
    season          String?
    player          String?
    brand           String?
    published       Boolean          @default(false)
    featured        Boolean          @default(false)
    createdAt       TimestampString(3)     @default(now())
    updatedAt       TimestampString(3)
    cartItems       CartItem[]
    orderItems      OrderItem[]
    productImages   ProductImage[]
    productTags     ProductTag[]
    productVariants ProductVariant[]
    reviews         Review[]
    wishlistItems   WishlistItem[]
    category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Product_categoryId_fkey")
    vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Product_vendorId_fkey")

    @@index([categoryId], map: "Product_categoryId_idx")
    @@index([slug], map: "Product_slug_key", unique: true)
    @@index([team], map: "Product_team_idx")
    @@index([vendorId], map: "Product_vendorId_idx")

    @@map("Product")
  }

  model ProductVariant {
    id         String         @id(map: "ProductVariant_pkey")
    productId  String
    sku        String
    size       pg.enum(Size)
    color      String
    colorHex   String
    price      Numeric(10, 2)
    stock      Int            @default(0)
    model3dUrl String?
    createdAt  TimestampString(3)   @default(now())
    cartItems  CartItem[]
    orderItems OrderItem[]
    product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductVariant_productId_fkey", index: false)

    @@index([productId, size, color], map: "ProductVariant_productId_size_color_key", unique: true)
    @@index([sku], map: "ProductVariant_sku_key", unique: true)

    @@map("ProductVariant")
  }

  model CartItem {
    id        String         @id(map: "CartItem_pkey")
    userId    String
    productId String
    variantId String
    quantity  Int            @default(1)
    createdAt TimestampString(3)   @default(now())
    updatedAt TimestampString(3)
    product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartItem_productId_fkey", index: false)
    user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartItem_userId_fkey", index: false)
    variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CartItem_variantId_fkey", index: false)

    @@index([userId, variantId], map: "CartItem_userId_variantId_key", unique: true)

    @@map("CartItem")
  }

  model Coupon {
    id          String          @id(map: "Coupon_pkey")
    code        String
    description String?
    percentOff  Int
    maxDiscount Numeric(10, 2)?
    minSubtotal Numeric(10, 2)  @default(0)
    maxUses     Int?
    usedCount   Int             @default(0)
    active      Boolean         @default(true)
    expiresAt   TimestampString(3)?
    createdAt   TimestampString(3)    @default(now())
    orders      Order[]

    @@index([active], map: "Coupon_active_idx")
    @@index([code], map: "Coupon_code_key", unique: true)

    @@map("Coupon")
  }

  model Notification {
    id        String       @id(map: "Notification_pkey")
    userId    String
    title     String
    message   String
    _type     String       @default("info") @map("type")
    read      Boolean      @default(false)
    link      String?
    createdAt TimestampString(3) @default(now())
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Notification_userId_fkey", index: false)

    @@index([userId, read], map: "Notification_userId_read_idx")

    @@map("Notification")
  }

  model Reseller {
    id                     String                  @id(map: "Reseller_pkey")
    userId                 String                  @unique(map: "Reseller_userId_key")
    referralCode           String
    commissionRate         Float                   @default(0.1)
    priceFloor             Numeric(10, 2)          @default(0)
    priceCeiling           Numeric(10, 2)?
    status                 pg.enum(ResellerStatus) @default("PENDING")
    tier                   String                  @default("Bronze")
    createdAt              TimestampString(3)            @default(now())
    updatedAt              TimestampString(3)
    orders                 Order[]
    resellerPayoutRequests ResellerPayoutRequest[]
    resellerSales          ResellerSale[]
    user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Reseller_userId_fkey")

    @@index([referralCode], map: "Reseller_referralCode_key", unique: true)
    @@index([status], map: "Reseller_status_idx")

    @@map("Reseller")
  }

  model Order {
    id              String                 @id(map: "Order_pkey")
    orderNumber     String
    userId          String
    addressId       String?
    status          pg.enum(OrderStatus)   @default("PENDING")
    paymentStatus   pg.enum(PaymentStatus) @default("PENDING")
    paymentIntentId String?
    subtotal        Numeric(10, 2)
    shipping        Numeric(10, 2)
    tax             Numeric(10, 2)
    total           Numeric(10, 2)
    notes           String?
    createdAt       TimestampString(3)           @default(now())
    updatedAt       TimestampString(3)
    couponId        String?
    discount        Numeric(10, 2)         @default(0)
    resellerId      String?
    orderItems      OrderItem[]
    resellerSales   ResellerSale[]
    tasks           Task[]
    tickets         Ticket[]
    address         Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Order_addressId_fkey", index: false)
    coupon          Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Order_couponId_fkey", index: false)
    reseller        Reseller?              @relation(fields: [resellerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Order_resellerId_fkey", index: false)
    user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_userId_fkey")

    @@index([orderNumber], map: "Order_orderNumber_key", unique: true)
    @@index([status], map: "Order_status_idx")
    @@index([userId], map: "Order_userId_idx")

    @@map("Order")
  }

  model OrderItem {
    id        String         @id(map: "OrderItem_pkey")
    orderId   String
    productId String
    variantId String
    vendorId  String
    quantity  Int
    price     Numeric(10, 2)
    total     Numeric(10, 2)
    order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderItem_orderId_fkey", index: false)
    product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "OrderItem_productId_fkey", index: false)
    variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "OrderItem_variantId_fkey", index: false)

    @@map("OrderItem")
  }

  model Payout {
    id             String         @id(map: "Payout_pkey")
    vendorId       String
    amount         Numeric(10, 2)
    stripePayoutId String?
    status         String
    createdAt      TimestampString(3)   @default(now())
    vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Payout_vendorId_fkey", index: false)

    @@map("Payout")
  }

  model PermissionOverride {
    id         String               @id(map: "PermissionOverride_pkey")
    userId     String
    permission String
    access     pg.enum(GrantAccess) @default("GRANT")
    grantType  pg.enum(GrantType)   @default("PERMANENT")
    expiresAt  TimestampString(3)?
    reason     String?
    grantedBy  String?
    createdAt  TimestampString(3)         @default(now())
    user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PermissionOverride_userId_fkey")

    @@index([userId], map: "PermissionOverride_userId_idx")
    @@index([userId, permission], map: "PermissionOverride_userId_permission_key", unique: true)

    @@map("PermissionOverride")
  }

  model ProductImage {
    id        String  @id(map: "ProductImage_pkey")
    productId String
    url       String
    alt       String?
    position  Int     @default(0)
    isPrimary Boolean @default(false)
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductImage_productId_fkey", index: false)

    @@map("ProductImage")
  }

  model Tag {
    id          String       @id(map: "Tag_pkey")
    name        String
    slug        String
    productTags ProductTag[]

    @@index([name], map: "Tag_name_key", unique: true)
    @@index([slug], map: "Tag_slug_key", unique: true)

    @@map("Tag")
  }

  model ProductTag {
    productId String
    tagId     String
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductTag_productId_fkey", index: false)
    tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductTag_tagId_fkey", index: false)

    @@id([productId, tagId], map: "ProductTag_pkey")

    @@map("ProductTag")
  }

  model ResellerPayoutRequest {
    id          String         @id(map: "ResellerPayoutRequest_pkey")
    resellerId  String
    amount      Numeric(10, 2)
    status      String         @default("PENDING")
    note        String?
    createdAt   TimestampString(3)   @default(now())
    processedAt TimestampString(3)?
    reseller    Reseller       @relation(fields: [resellerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ResellerPayoutRequest_resellerId_fkey")

    @@index([resellerId], map: "ResellerPayoutRequest_resellerId_idx")

    @@map("ResellerPayoutRequest")
  }

  model ResellerSale {
    id               String         @id(map: "ResellerSale_pkey")
    resellerId       String
    orderId          String
    commissionEarned Numeric(10, 2)
    status           String         @default("PENDING")
    createdAt        TimestampString(3)   @default(now())
    order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ResellerSale_orderId_fkey", index: false)
    reseller         Reseller       @relation(fields: [resellerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ResellerSale_resellerId_fkey")

    @@index([resellerId], map: "ResellerSale_resellerId_idx")

    @@map("ResellerSale")
  }

  model Review {
    id        String       @id(map: "Review_pkey")
    userId    String
    productId String
    rating    Int
    title     String?
    comment   String
    verified  Boolean      @default(false)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)
    product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Review_productId_fkey", index: false)
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Review_userId_fkey", index: false)

    @@index([userId, productId], map: "Review_userId_productId_key", unique: true)

    @@map("Review")
  }

  model Session {
    id           String       @id(map: "Session_pkey")
    sessionToken String
    userId       String
    expires      TimestampString(3)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Session_userId_fkey", index: false)

    @@index([sessionToken], map: "Session_sessionToken_key", unique: true)

    @@map("Session")
  }

  model Setting {
    id        String       @id(map: "Setting_pkey")
    key       String
    value     Jsonb
    updatedAt TimestampString(3)

    @@index([key], map: "Setting_key_key", unique: true)

    @@map("Setting")
  }

  model Worker {
    id        String                @id(map: "Worker_pkey")
    ownerId   String
    userId    String                @unique(map: "Worker_userId_key")
    name      String
    email     String
    phone     String?
    status    pg.enum(WorkerStatus) @default("ACTIVE")
    createdAt TimestampString(3)          @default(now())
    updatedAt TimestampString(3)
    tasks     Task[]
    tickets   Ticket[]
    owner     User                  @relation(name: "Worker_ownerId_fkey", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Worker_ownerId_fkey")
    user      User                  @relation(name: "Worker_userId_fkey", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Worker_userId_fkey")

    @@index([ownerId], map: "Worker_ownerId_idx")

    @@map("Worker")
  }

  model Task {
    id          String                @id(map: "Task_pkey")
    title       String
    description String?
    status      pg.enum(TaskStatus)   @default("PENDING")
    priority    pg.enum(TaskPriority) @default("MEDIUM")
    workerId    String?
    orderId     String?
    dueDate     TimestampString(3)?
    notes       String?
    createdAt   TimestampString(3)          @default(now())
    updatedAt   TimestampString(3)
    order       Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Task_orderId_fkey", index: false)
    worker      Worker?               @relation(fields: [workerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Task_workerId_fkey")

    @@index([status], map: "Task_status_idx")
    @@index([workerId], map: "Task_workerId_idx")

    @@map("Task")
  }

  model Ticket {
    id            String                @id(map: "Ticket_pkey")
    subject       String
    message       String
    status        pg.enum(TicketStatus) @default("OPEN")
    priority      pg.enum(TaskPriority) @default("MEDIUM")
    customerId    String
    workerId      String?
    orderId       String?
    createdAt     TimestampString(3)          @default(now())
    updatedAt     TimestampString(3)
    ticketReplies TicketReply[]
    customer      User                  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Ticket_customerId_fkey", index: false)
    order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Ticket_orderId_fkey", index: false)
    worker        Worker?               @relation(fields: [workerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Ticket_workerId_fkey")

    @@index([status], map: "Ticket_status_idx")
    @@index([workerId], map: "Ticket_workerId_idx")

    @@map("Ticket")
  }

  model TicketReply {
    id        String       @id(map: "TicketReply_pkey")
    ticketId  String
    authorId  String
    message   String
    createdAt TimestampString(3) @default(now())
    author    User         @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "TicketReply_authorId_fkey", index: false)
    ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TicketReply_ticketId_fkey", index: false)

    @@map("TicketReply")
  }

  model WishlistItem {
    id        String       @id(map: "WishlistItem_pkey")
    userId    String
    productId String
    createdAt TimestampString(3) @default(now())
    product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "WishlistItem_productId_fkey", index: false)
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "WishlistItem_userId_fkey", index: false)

    @@index([userId, productId], map: "WishlistItem_userId_productId_key", unique: true)

    @@map("WishlistItem")
  }

  native_enum GrantAccess {
    GRANT = "GRANT"
    DENY = "DENY"
  }

  native_enum GrantType {
    PERMANENT = "PERMANENT"
    TEMPORARY = "TEMPORARY"
    ONE_TIME = "ONE_TIME"
  }

  native_enum OrderStatus {
    PENDING = "PENDING"
    PROCESSING = "PROCESSING"
    SHIPPED = "SHIPPED"
    DELIVERED = "DELIVERED"
    CANCELLED = "CANCELLED"
    REFUNDED = "REFUNDED"
  }

  native_enum PaymentStatus {
    PENDING = "PENDING"
    PAID = "PAID"
    FAILED = "FAILED"
    REFUNDED = "REFUNDED"
  }

  native_enum ResellerStatus {
    PENDING = "PENDING"
    APPROVED = "APPROVED"
    SUSPENDED = "SUSPENDED"
  }

  native_enum Role {
    CUSTOMER = "CUSTOMER"
    OWNER = "OWNER"
    WORKER = "WORKER"
    ADMIN = "ADMIN"
  }

  native_enum Size {
    XS = "XS"
    S = "S"
    M = "M"
    L = "L"
    XL = "XL"
    XXL = "XXL"
  }

  native_enum TaskPriority {
    LOW = "LOW"
    MEDIUM = "MEDIUM"
    HIGH = "HIGH"
    URGENT = "URGENT"
  }

  native_enum TaskStatus {
    PENDING = "PENDING"
    IN_PROGRESS = "IN_PROGRESS"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
  }

  native_enum TicketStatus {
    OPEN = "OPEN"
    IN_PROGRESS = "IN_PROGRESS"
    RESOLVED = "RESOLVED"
    CLOSED = "CLOSED"
  }

  native_enum VendorStatus {
    PENDING = "PENDING"
    APPROVED = "APPROVED"
    SUSPENDED = "SUSPENDED"
  }

  native_enum WorkerStatus {
    ACTIVE = "ACTIVE"
    INACTIVE = "INACTIVE"
  }
}
