# Database (Supabase Postgres)
# Percent-encode special chars in the password (e.g. @ -> %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — never expose this to the browser, never prefix it
# with NEXT_PUBLIC_, and never reference it from a 'use client' module.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKETS="product-images"
# Set to "true" AFTER applying supabase/persistence.sql — enables guest cart/wishlist
# sync to the Supabase tables. Leave unset/"false" until the SQL is applied.
NEXT_PUBLIC_SUPABASE_PERSISTENCE="true"

# Optional. Comma-separated list of extra origins allowed to make cookie-authenticated
# mutations (e.g. "https://staging.example.com"). Empty means same-origin only.
ALLOWED_ORIGINS=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Frontend publishable key — required for Stripe Elements to load
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."

# Sanity CMS (optional)
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_API_TOKEN=""
